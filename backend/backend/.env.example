# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of frontend URLs allowed to call this API
# (locally AND your deployed frontend, once you have one)
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/lostfound

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Only allow signups from your college email domain
ALLOWED_EMAIL_DOMAIN=mitsgwl.ac.in

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials
# → Create OAuth Client ID → Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Image storage (Cloudinary example — swap for whatever you use)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_FROM=noreply@college.edu
RESEND_API_KEY=

# AI features (optional, backend runs fine without these set)
AI_MATCHING_ENABLED=false
AI_API_KEY=
