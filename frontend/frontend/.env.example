# Your backend's URL
VITE_API_BASE_URL=http://localhost:4000

# Same Client ID you created in Google Cloud Console (safe to expose publicly,
# unlike a secret key — this one is designed to be visible in frontend code)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cloudinary (image upload) — from cloudinary.com dashboard
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
